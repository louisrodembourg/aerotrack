# CUDA training image. Built for linux/amd64; the host only needs an NVIDIA driver >= 525
# and the NVIDIA container toolkit (torch cu126 wheels bundle CUDA and cuDNN themselves,
# so a `base` CUDA image is enough).
#
#   docker buildx build --platform linux/amd64 -f docker/Dockerfile.cuda \
#       --build-arg GIT_COMMIT=$(git rev-parse HEAD) -t aerotrack:cuda .
# NVIDIA's own registry: anonymous pulls, no Docker Hub rate limit on shared GPU hosts.
FROM nvcr.io/nvidia/cuda:12.6.3-base-ubuntu24.04

COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /usr/local/bin/

# libGL / glib: runtime dependencies of opencv-python.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    AEROTRACK_DATA=/data \
    AEROTRACK_RUNS=/runs \
    AEROTRACK_WEIGHTS=/weights \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

# Dependencies first: this layer only rebuilds when the lockfile changes.
COPY pyproject.toml uv.lock .python-version README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
COPY configs ./configs
COPY scripts ./scripts
RUN uv sync --frozen --no-dev

# The image has no .git: the commit is baked in so every run still records it.
ARG GIT_COMMIT=unknown
ARG GIT_DIRTY=unknown
ENV AEROTRACK_GIT_COMMIT=$GIT_COMMIT \
    AEROTRACK_GIT_DIRTY=$GIT_DIRTY

VOLUME ["/data", "/runs", "/weights"]
ENTRYPOINT ["aerotrack"]
CMD ["--help"]
